{
  "name": "bake-ry-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting:bake-ry",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:run": "node scripts/e2e-run.mjs",
    "e2e:inventory": "playwright test -c playwright.inventory.config.js",
    "e2e:inventory:report": "playwright show-report e2e/report-inventory",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@carsalhaz/vue-data-table": "^1.0.9",
    "@headlessui/vue": "^1.7.23",
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-form": "^0.35.0",
    "@tanstack/vue-table": "^8.20.5",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.7.7",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^11.0.1",
    "pinia": "^2.2.4",
    "tailwindcss": "^3.4.15",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-vue": "^9.30.0",
    "happy-dom": "^18.0.1",
    "sass": "^1.83.0",
    "vite": "^5.4.8",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.4"
  }
}
